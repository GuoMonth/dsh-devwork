import assert from 'node:assert/strict'
import { test } from 'node:test'
import { MemoryTaskLogStore, TaskDomainError, TaskRepository, parseTaskLog, replay, taskTree } from '../../lib/task-center/index.js'

const at = new Date('2026-10-14T00:00:00.000Z')
const create = (id: string, parentId: string | null = null, dependencyIds: string[] = []) => ({ type: 'task.create' as const, id, parentId, title: `Task ${id}`, goal: `Goal ${id}`, scope: ['src'], acceptance: ['check'], dependencyIds })

test('task repository persists a one-primary-session task and retry attempts', async () => {
  const store = new MemoryTaskLogStore()
  const repo = new TaskRepository(store, () => at)
  let view = await repo.dispatch(create('root'))
  assert.equal(view.revision, 1)
  view = await repo.dispatch({ type: 'session.create', id: 'session-root', taskId: 'root', externalSessionId: 'dsh-session-root' })
  view = await repo.dispatch({ type: 'attempt.start', id: 'attempt-1', sessionId: 'session-root', agentId: 'agent' })
  view = await repo.dispatch({ type: 'attempt.transition', attemptId: 'attempt-1', status: 'failed' })
  view = await repo.dispatch({ type: 'attempt.start', id: 'attempt-2', sessionId: 'session-root', agentId: 'agent' })
  assert.equal(view.attempts.at(-1)?.number, 2)
  assert.equal(view.sessions[0]?.status, 'running')
  await assert.rejects(() => repo.dispatch({ type: 'session.create', id: 'session-duplicate', taskId: 'root', externalSessionId: null }), TaskDomainError)
  assert.equal((await repo.snapshot()).revision, 5)
})

test('repository serializes concurrent commands and preserves every event', async () => {
  const repo = new TaskRepository(new MemoryTaskLogStore(), () => at)
  await repo.dispatch(create('root'))
  await Promise.all([
    repo.dispatch(create('child-a', 'root')),
    repo.dispatch(create('child-b', 'root')),
  ])
  const view = await repo.snapshot()
  assert.equal(view.revision, 3)
  assert.deepEqual(view.tasks.map(task => task.id), ['root', 'child-a', 'child-b'])
})

test('blocked tasks retain a reason and dependencies gate activation', async () => {
  const repo = new TaskRepository(new MemoryTaskLogStore(), () => at)
  await repo.dispatch(create('dependency'))
  await repo.dispatch(create('consumer', null, ['dependency']))
  await assert.rejects(() => repo.dispatch({ type: 'task.transition', taskId: 'consumer', status: 'active' }), TaskDomainError)
  await repo.dispatch({ type: 'task.transition', taskId: 'dependency', status: 'active' })
  await repo.dispatch({ type: 'task.block', taskId: 'dependency', reason: 'waiting for provider' })
  const blocked = await repo.snapshot()
  assert.equal(blocked.tasks.find(task => task.id === 'dependency')?.blockedReason, 'waiting for provider')
  const resumed = await repo.dispatch({ type: 'task.transition', taskId: 'dependency', status: 'active' })
  assert.equal(resumed.tasks.find(task => task.id === 'dependency')?.status, 'active')
})

test('parent completion requires terminal children and replay rejects malformed logs', async () => {
  const repo = new TaskRepository(new MemoryTaskLogStore(), () => at)
  await repo.dispatch(create('root'))
  await repo.dispatch(create('child', 'root'))
  await repo.dispatch({ type: 'task.transition', taskId: 'root', status: 'active' })
  await repo.dispatch({ type: 'task.transition', taskId: 'child', status: 'active' })
  await repo.dispatch({ type: 'task.transition', taskId: 'child', status: 'review' })
  await repo.dispatch({ type: 'task.transition', taskId: 'root', status: 'review' })
  await assert.rejects(() => repo.dispatch({ type: 'task.transition', taskId: 'root', status: 'completed' }), TaskDomainError)
  await repo.dispatch({ type: 'task.transition', taskId: 'child', status: 'completed' })
  const done = await repo.dispatch({ type: 'task.transition', taskId: 'root', status: 'completed' })
  assert.equal(done.tasks.find(task => task.id === 'root')?.status, 'completed')
  assert.throws(() => replay(parseTaskLog({ version: 1, events: [{ sequence: 2, occurredAt: at.toISOString(), command: create('bad') }] })), TaskDomainError)
  assert.equal(replay({ version: 1, events: [] }).revision, 0)
  await assert.rejects(() => repo.dispatch(create('late-child', 'root')), /terminal/)
})

test('task tree mirrors session relationships and exposes blocked descendants without completing parents', async () => {
  const repo = new TaskRepository(new MemoryTaskLogStore(), () => at)
  await repo.dispatch(create('root'))
  await repo.dispatch(create('child', 'root'))
  await repo.dispatch({ type: 'session.create', id: 'root-session', taskId: 'root', externalSessionId: 'root-dsh' })
  await repo.dispatch({ type: 'session.create', id: 'child-session', taskId: 'child', externalSessionId: 'child-dsh' })
  await repo.dispatch({ type: 'task.block', taskId: 'child', reason: 'Needs input' })
  const tree = taskTree(await repo.snapshot())
  assert.equal(tree[0]?.children[0]?.parentSessionId, 'root-session')
  assert.equal(tree[0]?.children[0]?.session?.id, 'child-session')
  assert.deepEqual(tree[0]?.progress, { total: 1, completed: 0, cancelled: 0, blocked: 1 })
  assert.equal(tree[0]?.task.status, 'pending')
  await assert.rejects(() => repo.dispatch({ type: 'task.reparent', taskId: 'root', parentId: 'child' }), /cycle/)
  await assert.rejects(() => repo.dispatch(create('deadlocked-child', 'root', ['root'])), /cycle/)
  await repo.dispatch(create('consumer', null, ['root']))
  await assert.rejects(() => repo.dispatch({ type: 'task.reparent', taskId: 'consumer', parentId: 'root' }), /cycle/)
})

test('active attempts and cross-task output links cannot corrupt delivery state', async () => {
  const repo = new TaskRepository(new MemoryTaskLogStore(), () => at)
  await repo.dispatch(create('one'))
  await repo.dispatch(create('two'))
  await repo.dispatch({ type: 'session.create', id: 'session', taskId: 'one', externalSessionId: 'dsh' })
  await assert.rejects(() => repo.dispatch({ type: 'session.create', id: 'other', taskId: 'two', externalSessionId: 'dsh' }), /already bound/)
  await repo.dispatch({ type: 'attempt.start', id: 'attempt', sessionId: 'session', agentId: 'agent' })
  await assert.rejects(() => repo.dispatch({ type: 'attempt.start', id: 'second', sessionId: 'session', agentId: 'agent' }), /active attempt/)
  await assert.rejects(() => repo.dispatch({ type: 'task.transition', taskId: 'one', status: 'cancelled' }), /active attempt/)
  await assert.rejects(() => repo.dispatch({ type: 'artifact.create', id: 'cross-task', taskId: 'two', attemptId: 'attempt', kind: 'commit', uri: 'commit:abc' }), /another task/)
  await repo.dispatch({ type: 'artifact.create', id: 'output', taskId: 'one', attemptId: 'attempt', kind: 'commit', uri: 'commit:abc' })
  await assert.rejects(() => repo.dispatch({ type: 'integration.create', id: 'cross-task', taskId: 'two', artifactId: 'output', provider: 'github', url: 'https://github.com/a/b/pull/1' }), /another task/)
  await repo.dispatch({ type: 'attempt.transition', attemptId: 'attempt', status: 'cancelled' })
  await repo.dispatch({ type: 'task.transition', taskId: 'one', status: 'cancelled' })
  await assert.rejects(() => repo.dispatch({ type: 'attempt.start', id: 'late', sessionId: 'session', agentId: 'agent' }), /terminal/)
})

test('artifacts, integrations and workspace leases remain tied to the task', async () => {
  const repo = new TaskRepository(new MemoryTaskLogStore(), () => at)
  await repo.dispatch(create('task'))
  await repo.dispatch({ type: 'session.create', id: 'session', taskId: 'task', externalSessionId: null })
  await repo.dispatch({ type: 'attempt.start', id: 'attempt', sessionId: 'session', agentId: 'agent' })
  await repo.dispatch({ type: 'artifact.create', id: 'artifact', taskId: 'task', attemptId: 'attempt', kind: 'commit', uri: 'commit:abc' })
  await repo.dispatch({ type: 'artifact.transition', artifactId: 'artifact', status: 'ready' })
  await repo.dispatch({ type: 'integration.create', id: 'pr', taskId: 'task', artifactId: 'artifact', provider: 'github', url: 'https://github.com/example/repo/pull/1' })
  await repo.dispatch({ type: 'integration.transition', integrationId: 'pr', status: 'open' })
  await repo.dispatch({ type: 'lease.reserve', id: 'lease', taskId: 'task', path: '/tmp/task', kind: 'worktree' })
  const active = await repo.dispatch({ type: 'lease.activate', leaseId: 'lease' })
  assert.equal(active.integrations[0]?.status, 'open')
  assert.equal(active.leases[0]?.status, 'active')
  await assert.rejects(() => repo.dispatch({ type: 'integration.create', id: 'bad', taskId: 'task', artifactId: null, provider: 'github', url: 'http://github.com/example/repo/pull/2' }), TaskDomainError)
})
